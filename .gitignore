data/smartvoca.db
data/*.db
data/backups/

# 비밀정보 (CLAUDE.md 규칙 5)
.env

# Python 실행 산출물
__pycache__/
*.pyc
.venv/
venv/

# 배포 산출물 (FR-23)
build/
dist/
dist_new/
*.spec

# 테스트 캐시
.pytest_cache/

# 에디터·OS 파일
.vscode/
.idea/
Thumbs.db
desktop.ini
